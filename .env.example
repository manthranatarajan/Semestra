# ==============================================
# Smart Syllabus - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# ==============================================

# Frontend (Vite) - Required for React app
# Get these from: https://app.supabase.com/project/<your-project-id>/settings/api
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ==============================================
# Backend / Edge Functions (Optional)
# ==============================================
# These are used by Supabase Edge Functions
# Set these as secrets in Supabase Dashboard or CLI:
# supabase secrets set OPENAI_API_KEY=your_key

# OpenAI API (for AI-powered syllabus parsing)
OPENAI_API_KEY=<your-openai-api-key>

# Gemini API (alternative to OpenAI)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# ==============================================
# Notes:
# ==============================================
# 1. Vite variables MUST start with VITE_ to be exposed to the frontend
# 2. Never commit your .env file to version control
# 3. Restart dev server after changing environment variables
# 4. Edge function secrets are managed separately in Supabase
